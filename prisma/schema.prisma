generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      String
  icon      String   @default("Tag")
  color     String   @default("#10B981")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("categories")
}

model Income {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId    String   @db.ObjectId
  amount        Float
  date          String
  description   String
  paymentMethod String   @default("BANK_TRANSFER")
  tags          String[]
  createdAt     DateTime @default(now())

  @@map("incomes")
}

model Expense {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  categoryId    String   @db.ObjectId
  amount        Float
  date          String
  description   String
  paymentMethod String   @default("CASH")
  tags          String[]
  createdAt     DateTime @default(now())

  @@map("expenses")
}

model Customer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  nicNo       String
  phoneNo     String
  address     String
  boxNo       String
  totalAmount Float
  paidAmount  Float
  status      String   @default("ACTIVE")
  packageId   String?  
  packageName String?  
  monthlyFee  Float?   
  createdAt   DateTime @default(now())

  @@map("customers")
}

model MonthlyPayment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  customerId    String   @db.ObjectId
  customerName  String
  boxNo         String
  month         String
  monthlyFee    Float
  paidAmount    Float
  paymentDate   String
  createdAt     DateTime @default(now())

  @@map("monthly_payments")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  password  String
  name      String
  role      String   @default("STAFF") // ADMIN or STAFF
  createdAt DateTime @default(now())

  @@map("users")
}

model Setting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @default(now()) @updatedAt

  @@map("settings")
}

model CablePackage {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  packageId     String   @unique
  name          String
  shortName     String
  monthlyFee    Float
  channelsCount String
  color         String   @default("from-blue-500 to-indigo-600")
  badgeBg       String   @default("bg-blue-500/15")
  badgeBorder   String   @default("border-blue-500/30")
  badgeText     String   @default("text-blue-400")
  description   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@map("packages")
}


